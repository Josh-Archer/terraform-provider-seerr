{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Unit Tests in Current Package",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}"
    },
    {
      "name": "Debug Provider Locally (TF_REATTACH_PROVIDERS)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/main.go",
      "args": ["-debug"]
    },
    {
      "name": "Run OpenAPI Diff Tool",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/tools/openapi",
      "args": ["diff"]
    }
  ]
}
